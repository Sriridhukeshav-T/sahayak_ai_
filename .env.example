# ==========================================
# SAHAYAK AI — Environment Configuration
# ==========================================

# Port for local backend Node.js server
PORT=5001

# MongoDB Atlas Connection URI
# 1. Sign up for free at https://www.mongodb.com/cloud/atlas
# 2. Create a Free M0 Cluster
# 3. Under "Database Access", create a database user (e.g., sahayak_admin and a secure password)
# 4. Under "Network Access", add IP Access List: 0.0.0.0/0 (allow access from anywhere, required for Vercel)
# 5. Click "Connect" -> "Drivers" -> copy connection string:
# Replace <username> and <password> with your MongoDB user credentials:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/sahayak_db?retryWrites=true&w=majority

# Database name (Optional, defaults to sahayak_db)
MONGODB_DB_NAME=sahayak_db
